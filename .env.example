# PhishGuard AI — copy to .env and adjust

# Scanner: local (trained model, no API key) | custom (HTTP AI) | rules (rule-based only)
AI_PROVIDER=local

# Optional: path to trained model (default: ./trained_scanner.joblib)
# TRAINED_MODEL_PATH=./trained_scanner.joblib

# Optional: custom HTTP AI when AI_PROVIDER=custom
# CUSTOM_AI_URL=http://localhost:8000/analyze
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_TIMEOUT=30

# Optional: Postgres for persistent adaptive learning (Vercel/Supabase/Neon)
# DATABASE_URL=postgres://...

# Flask
SECRET_KEY=change-me-in-production
FLASK_DEBUG=true
